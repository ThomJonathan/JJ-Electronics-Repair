generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  products Product[]
}

model Product {
  id             Int      @id @default(autoincrement())
  sku            String?  @unique
  name           String
  categoryId     Int?
  category       Category? @relation(fields: [categoryId], references: [id])
  brand          String?
  description    String?
  reorderLevel   Int      @default(5)
  avgCost        Decimal  @default(0) @db.Decimal(12, 2) // weighted-average cost, updated on receiving
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  purchaseOrderItems PurchaseOrderItem[]
  saleItems          SaleItem[]
  stockMovements     StockMovement[]
}

model Supplier {
  id             Int      @id @default(autoincrement())
  name           String
  phone          String?
  notes          String?
  purchaseOrders PurchaseOrder[]
}

enum PurchaseOrderStatus {
  pending
  partially_received
  received
  cancelled
}

model PurchaseOrder {
  id            Int                 @id @default(autoincrement())
  supplierId    Int?
  supplier      Supplier?           @relation(fields: [supplierId], references: [id])
  referenceNo   String?
  orderDate     DateTime            @default(now()) @db.Date
  expectedDate  DateTime?           @db.Date
  status        PurchaseOrderStatus @default(pending)
  createdAt     DateTime            @default(now())

  items              PurchaseOrderItem[]
  goodsReceivedNotes GoodsReceivedNote[]
}

model PurchaseOrderItem {
  id                Int           @id @default(autoincrement())
  purchaseOrderId   Int
  purchaseOrder     PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId         Int
  product           Product       @relation(fields: [productId], references: [id])
  quantityOrdered   Int
  quantityReceived  Int           @default(0)
  unitCost          Decimal       @db.Decimal(12, 2)

  goodsReceivedItems GoodsReceivedItem[]
}

model GoodsReceivedNote {
  id              Int           @id @default(autoincrement())
  purchaseOrderId Int
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  receivedDate    DateTime      @default(now()) @db.Date
  receivedBy      String?

  items GoodsReceivedItem[]
}

model GoodsReceivedItem {
  id        Int               @id @default(autoincrement())
  grnId     Int
  grn       GoodsReceivedNote @relation(fields: [grnId], references: [id], onDelete: Cascade)
  poItemId  Int
  poItem    PurchaseOrderItem @relation(fields: [poItemId], references: [id])
  quantity  Int
}

enum MovementType {
  purchase
  sale
  adjustment
}

model StockMovement {
  id             Int          @id @default(autoincrement())
  productId      Int
  product        Product      @relation(fields: [productId], references: [id])
  movementType   MovementType
  quantity       Int          // positive = stock in, negative = stock out
  referenceType  String?      // 'purchase_order_item' | 'sale_item' | 'manual'
  referenceId    Int?
  createdAt      DateTime     @default(now())
}

model Sale {
  id           Int      @id @default(autoincrement())
  saleDate     DateTime @default(now()) @db.Date
  customerName String?
  totalAmount  Decimal  @db.Decimal(12, 2)
  totalCost    Decimal  @db.Decimal(12, 2)
  createdAt    DateTime @default(now())

  items SaleItem[]
}

model SaleItem {
  id        Int     @id @default(autoincrement())
  saleId    Int
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId Int
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Decimal @db.Decimal(12, 2)
  unitCost  Decimal @db.Decimal(12, 2)
}
